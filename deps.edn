{:paths ["src" "resources"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.0"}
        org.clojure/core.logic {:mvn/version "1.1.0"}
        ;; The native rendering backend. Sibling checkout in dev; a
        ;; published coordinate replaces :local/root for release.
        com.leifericf/clj-zig  {:local/root "../zigar"}}
 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.5.1"}}
        :jvm-opts ["-Djdk.attach.allowAttachSelf"
                   "--add-opens=java.base/java.lang=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  :perf {:jvm-opts ["-server"
                    "-XX:+UseG1GC"
                    "-XX:MaxGCPauseMillis=200"
                    "-XX:CompileThreshold=500"
                    "-XX:+OptimizeStringConcat"
                    "-Xmx1g" "-Xms512m"
                    "-Xmn384m"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Integration tests drive the native Phane backend. They live on their
  ;; own path so the default lane never loads them: they need a zig
  ;; toolchain and a sibling phane checkout. Run with `clojure -M:integration`.
  :integration {:extra-paths ["test-integration"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.1"}}
                :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "cognitect.test-runner" "-d" "test-integration"]}
  ;; Cross-compile the native Phane boundary for every target into resources,
  ;; so the published jar renders with no zig toolchain (clj-zig ADR 36).
  ;; Needs a local phane checkout (sibling or PHANE_MODULE_ROOT). For a quick
  ;; host-only build: clojure -X:bake :targets :host
  :bake {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :exec-fn clj-zig.bake/bake!
         :exec-args {:ns eido.phane :out "resources"}}}}
